{
  "compilerOptions": {
    "target": "ES2022",
//    "module": "NodeNext",
    "moduleResolution": "NodeNext",
//    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "outDir": "./dist",      // MUST be this
    "rootDir": "./src",      // adjust if needed
    "module": "commonjs",


  },
  "include": [
    "src/**/*.ts",
    "generated/**/*.ts",
    "prisma.config.ts",
    "scripts/**/*.ts"
  ]
}
